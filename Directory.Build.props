<Project>
  <!-- ============================================================
       2026-11-07 新增：统一 6 个示例的公共配置
       动机（实测）：此前 6 个 csproj **各自重复** TargetFramework / Nullable /
       ImplicitUsings / 两个包版本 ⇒ 升级版本要改 6 处，**必漏** ✗
       ⇒ 抽到本文件 ⇒ 改一处生效全部 ✓
       ⚠️ AssemblyName / RootNamespace **保持各示例自己的**
          （`ZL.IotHub.Sample.*`，Owner 决定暂不改名 ✓）
       ============================================================ -->
  <PropertyGroup>
    <!-- 2026-11-07 改为**多目标**：net48 是 WinForm 主力客户群 ✓
         实测：6 个示例源码在 net48 下**编译 0 error** ✓（无需改一行代码 ✓）
         ⚠️ net48 目标只能在 **Windows** 上 `dotnet run`（macOS/Linux 无 .NET Framework 运行时 ✗）
         ⇒ CI 仍在 Linux 上只跑 net8.0 ✓；net48 只做**编译验证** ✓ -->
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>11</LangVersion>
    <!-- 包版本单一真源：升级只改这里 ✓ -->
    <!-- 2026-11-08：2.2.19→2.2.20。2.2.20 修复断网后 ConnectionState 冻结
         （IsConnected 恒 true，见 README「质量码」节与主仓 docs/600 A-91~94）；
         升级后 8 个示例全部跑在可信版本上 ✓ -->
    <IotEngineVersion>2.3.0</IotEngineVersion>
    <!-- SCADA/OPC UA 网关包版本（OpcUaServer 示例使用；它内部依赖 Engine/Driver 2.3.0） -->
    <IotServerVersion>2.3.0</IotServerVersion>
  </PropertyGroup>
</Project>
