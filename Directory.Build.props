<Project>
  <!-- ============================================================
       2026-11-07 新增：统一 6 个示例的公共配置
       动机（实测）：此前 6 个 csproj **各自重复** TargetFramework / Nullable /
       ImplicitUsings / 两个包版本 ⇒ 升级版本要改 6 处，**必漏** ✗
       ⇒ 抽到本文件 ⇒ 改一处生效全部 ✓
       ⚠️ AssemblyName / RootNamespace **保持各示例自己的**
          （`ZL.IotHub.Sample.*`，Owner 决定暂不改名 ✓）
       ============================================================ -->
  <PropertyGroup>
    <!-- 2026-11-07 改为**多目标**：net48 是 WinForm 主力客户群 ✓
         实测：6 个示例源码在 net48 下**编译 0 error** ✓（无需改一行代码 ✓）
         ⚠️ net48 目标只能在 **Windows** 上 `dotnet run`（macOS/Linux 无 .NET Framework 运行时 ✗）
         ⇒ CI 仍在 Linux 上只跑 net8.0 ✓；net48 只做**编译验证** ✓ -->
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>11</LangVersion>
    <!-- 包版本单一真源：升级只改这里 ✓ -->
    <IotEngineVersion>2.2.19</IotEngineVersion>
  </PropertyGroup>
</Project>
