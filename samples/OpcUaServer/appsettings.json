{
  "Urls": "http://localhost:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Scada": {
    "Cors": {
      "AllowedOrigins": []
    },
    "Devices": [
      {
        "DeviceId": "PLC001",
        "Protocol": "siemens-s7",
        "Params": {
          "DeviceIp": "127.0.0.1",
          "Port": "31002",
          "Rack": "0",
          "Slot": "1"
        },
        "Tags": [
          {
            "Id": "Temperature",
            "Description": "温度",
            "Address": "DB1.DBD0",
            "DataTypeCode": "float",
            "Length": 4,
            "AccessMode": "ReadOnly"
          },
          {
            "Id": "Pressure",
            "Description": "压力",
            "Address": "DB1.DBD4",
            "DataTypeCode": "float",
            "Length": 4,
            "AccessMode": "ReadOnly"
          },
          {
            "Id": "Count",
            "Description": "计数",
            "Address": "DB1.DBW2",
            "DataTypeCode": "short",
            "Length": 2,
            "AccessMode": "ReadOnly"
          },
          {
            "Id": "Run",
            "Description": "运行状态",
            "Address": "DB1.DBX0.0",
            "DataTypeCode": "bool",
            "Length": 1,
            "AccessMode": "ReadOnly"
          },
          {
            "Id": "Setpoint",
            "Description": "设定值（可写）",
            "Address": "DB1.DBD8",
            "DataTypeCode": "float",
            "Length": 4,
            "AccessMode": "ReadWrite",
            "InitialValue": "60.0",
            "WriteInitialValue": true
          }
        ]
      }
    ]
  },
  "OpcUa": {
    "Enabled": true,
    "Port": 4840,
    "SecurityPolicy": "None"
  }
}
