<?xml version="1.0" encoding="utf-8"?>
<!--
  Events 示例的设备与点表配置

  ★ 改 IP / 端口 / 点位只改这个文件，不用重新编译。
  ★ 示例会周期性写 COUNT 来触发变化事件 ⇒ COUNT 必须显式 ReadWrite。
-->
<Device
    DeviceId="EVENT-DEMO"
    Protocol="siemens-s7"
    DeviceIp="127.0.0.1"
    Port="31002"
    Rack="0"
    Slot="1"
    ReadInterval="500">

  <TagItem Id="COUNT" Description="计数（示例会写它）" Address="DB1.DBW2" DataTypeCode="short" TagType="M" AccessMode="ReadWrite" />
  <TagItem Id="TEMP"  Description="温度" Address="DB1.DBD4" DataTypeCode="float" TagType="M" />

</Device>
