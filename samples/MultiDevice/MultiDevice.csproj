<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZL.IotHub.Sample.MultiDevice</AssemblyName>
    <RootNamespace>ZL.IotHub.Sample.MultiDevice</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2026-11-07：ZL.IotHub 已冻结停发，迁移到 ZL.IotEngine + ZL.IotDriver -->
    <PackageReference Include="ZL.IotEngine" Version="2.2.19" />
    <PackageReference Include="ZL.IotDriver" Version="2.2.19" />
  </ItemGroup>

  <!-- 批量仿真配置：随示例一起交付（plcsim —batch fleet.json 会用） -->
  <ItemGroup>
    <None Update="fleet.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
