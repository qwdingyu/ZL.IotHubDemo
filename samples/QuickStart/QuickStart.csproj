    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZL.IotHub.Sample.QuickStart</AssemblyName>
    <RootNamespace>ZL.IotHub.Sample.QuickStart</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2026-11-07：ZL.IotHub 已冻结停发（2.2.17 为最后版本）
