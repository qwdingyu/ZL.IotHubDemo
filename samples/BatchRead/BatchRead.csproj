<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ZL.IotHub.Sample.BatchRead</AssemblyName>
    <RootNamespace>ZL.IotHub.Sample.BatchRead</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2026-11-07：ZL.IotHub 已冻结停发，迁移到 ZL.IotEngine + ZL.IotDriver -->
    <PackageReference Include="ZL.IotEngine" Version="$(IotEngineVersion)" />
    <PackageReference Include="ZL.IotDriver" Version="$(IotEngineVersion)" />
  </ItemGroup>

  <!-- 设备配置：复制到输出目录 -->
  <ItemGroup>
    <Content Include="batchread.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
